{
  "name": "wilfredo-portfolio",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "cf:build": "astro build && node -e \"require('fs').copyFileSync('cloudflare/_headers', 'dist/_headers')\"",
    "cf:staging": "npm run cf:build && npx --yes wrangler@4 deploy --env staging",
    "cf:deploy": "npm run cf:build && npx --yes wrangler@4 deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.3.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0"
  }
}
